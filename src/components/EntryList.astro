---
import { entryUrl, type Entry } from "../lib/entries";
import EntryMeta from "./EntryMeta.astro";

interface Props {
	entries: Entry[];
}

const { entries } = Astro.props;
---

{
	entries.length === 0 ? (
		<p class="empty">Todavía no hay entradas.</p>
	) : (
		<ul class="entries">
			{entries.map((entry) => (
				<li class="entry">
					<EntryMeta date={entry.data.date} tags={entry.data.tags} />
					<h2 class="title">
						<a href={entryUrl(entry)}>{entry.data.title}</a>
					</h2>
				</li>
			))}
		</ul>
	)
}

<style>
	.empty {
		color: var(--color-text-muted);
		text-align: center;
	}

	.entries {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.entry {
		padding-block: var(--space-l);
		border-bottom: 1px solid var(--color-border);
	}

	.title {
		margin: var(--space-2xs) 0 0;
		font-size: var(--text-h3);
		line-height: var(--leading-h3);
		/* Fill the line instead of balancing, so long titles use the full width */
		text-wrap: pretty;
	}

	/* Titles keep the text color; the underline on hover marks them as links */
	.title a {
		color: inherit;
		text-decoration: none;
	}

	.title a:hover {
		text-decoration: underline;
	}
</style>
