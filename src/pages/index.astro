---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const entries = [
	...(await getCollection("journal")),
	...(await getCollection("notebook")),
].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Frontmatter dates have no time and parse as UTC midnight, so read the UTC date
const formatDate = (date: Date) =>
	date.toISOString().slice(0, 10).split("-").reverse().join("-");
---

<BaseLayout title="Necronomicode">
	<h1 class="visually-hidden">Necronomicode</h1>
	<ul class="entries">
		{
			entries.map(({ id, collection, data }) => (
				<li class="entry">
					<div class="meta">
						<time datetime={data.date.toISOString()}>
							{formatDate(data.date)}
						</time>
						<ul class="tags">
							{data.tags.map((tag) => (
								<li>
									<a class="tag" href={`/tags/${tag}`}>
										{tag}
									</a>
								</li>
							))}
						</ul>
					</div>
					<h2 class="title">
						<a href={`/${collection}/${id}`}>{data.title}</a>
					</h2>
				</li>
			))
		}
	</ul>
</BaseLayout>

<style>
	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	/* Match the list width to its content so the column reads as centered */
	.entries {
		max-width: var(--measure);
		list-style: none;
		margin: 0 auto;
		padding: 0;
	}

	.entry {
		padding-block: var(--space-l);
		border-bottom: 1px solid var(--color-border);
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-s);
		font-size: var(--text-small);
		line-height: var(--leading-small);
		color: var(--color-text-muted);
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-xs);
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.tag {
		color: var(--color-accent);
		text-decoration: none;
	}

	.tag:hover {
		text-decoration: underline;
	}

	.title {
		margin: var(--space-2xs) 0 0;
		font-size: var(--text-h3);
		line-height: var(--leading-h3);
		/* Fill the line instead of balancing, so long titles use the full width */
		text-wrap: pretty;
	}

	/* Titles keep the text color; the underline on hover marks them as links */
	.title a {
		color: inherit;
		text-decoration: none;
	}

	.title a:hover {
		text-decoration: underline;
	}
</style>
