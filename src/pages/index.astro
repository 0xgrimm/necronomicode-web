---
import { getCollection } from "astro:content";
import EntryList from "../components/EntryList.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { byNewestFirst, entryCollections } from "../lib/entries";

const entries = (
	await Promise.all(entryCollections.map((name) => getCollection(name)))
)
	.flat()
	.sort(byNewestFirst);
---

<BaseLayout title="Necronomicode">
	<h1 class="visually-hidden">Necronomicode</h1>
	<div class="column">
		<EntryList entries={entries} />
	</div>
</BaseLayout>

<style>
	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	/* Match the list width to its content so the column reads as centered */
	.column {
		max-width: var(--measure);
		margin-inline: auto;
	}
</style>
